# RCC-HIROS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.

# MySQL database connection (XAMPP MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/rcc_hiros"

# Strong random secret for JWT signing (required)
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-to-a-random-secret"

# ZK Kiosk Fingerprint Service (loopback HTTP, not WebSocket)
NEXT_PUBLIC_KIOSK_SERVICE_URL="http://127.0.0.1:8765"

# ── Docker Compose / production deployment ──────────────────────
# Read by docker-compose.yml (variable interpolation).
# Compose refuses to start without DB_PASSWORD and JWT_SECRET.

# App DB user created inside the MariaDB container
DB_USER="rcc"
DB_PASSWORD="change-me-to-a-strong-db-password"

# Optional: Cloudflare named tunnel token (docker compose --profile tunnel up -d)
# Create with: cloudflared tunnel create rcc-hiros  →  dashboard / Zero Trust → Tunnels
TUNNEL_TOKEN=""
